# ─── Build variant ────────────────────────────────────────────────────────────
# development | preview | production. EAS builds set this per profile in eas.json;
# locally (Metro / development builds) it comes from this file.
EXPO_PUBLIC_APP_VARIANT=development

# ─── Backend ──────────────────────────────────────────────────────────────────
# Base URL of the WHA backend (the website itself — see docs/mobile/00-README.md).
# No trailing slash. Development: your PC's LAN IP running `npm run dev` in the
# website repo (with Stripe TEST keys), e.g. http://192.168.1.65:3000 — "localhost"
# on a phone means the phone itself. Production builds must use https://whaustralia.com.
# EXPO_PUBLIC_API_URL=http://192.168.1.65:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Publishable key only (never the secret key). Must be from the SAME Stripe account
# and mode as the backend's STRIPE_SECRET_KEY.
#   development / preview → pk_test_…   production → pk_live_…
# The app refuses to start if the key is missing or the wrong mode for the build.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Google sign-in (native, customers only) ─────────────────────────────────
# OAuth client IDs from Google Cloud Console → Credentials. Needs an app build (not
# Expo Go). Empty → the button says Google sign-in isn't set up.
#   WEB_CLIENT_ID   — "Web application" client; the ID token audience on Android.
#                     Must be one of the backend's GOOGLE_CLIENT_ID / _IOS_ / _ANDROID_.
#   IOS_CLIENT_ID   — "iOS" client (bundle ID com.whaustralia.app); token audience on iOS.
#   IOS_REVERSED_CLIENT_ID — that iOS client's reversed ID, com.googleusercontent.apps.…
#                     Used at BUILD time as the iOS URL scheme (app.config.ts).
# Android also needs an "Android" OAuth client (package com.whaustralia.app + the
# build's SHA-1) in the same Google Cloud project — its ID isn't used by the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_REVERSED_CLIENT_ID=

# ─── Google Maps (Android) ────────────────────────────────────────────────────
# API key for the map in the business Location step / Edit profile (LocationPicker).
# Read at BUILD time by the react-native-maps config plugin (app.config.ts) — a new
# value needs a new Android build. iOS uses Apple Maps (no key). Restrict the key to
# "Maps SDK for Android" + package com.whaustralia.app + the builds' SHA-1s.
# Empty → the Android map renders blank (Expo Go on Android uses its own key).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
