# ─── Build variant ────────────────────────────────────────────────────────────
# development | preview | production. EAS builds set this per profile in eas.json;
# locally (Metro / development builds) it comes from this file.
EXPO_PUBLIC_APP_VARIANT=development

# ─── Backend ──────────────────────────────────────────────────────────────────
# Base URL of the WHA backend (the website itself — see docs/mobile/00-README.md).
# No trailing slash. Development: your PC's LAN IP running `npm run dev` in the
# website repo (with Stripe TEST keys), e.g. http://192.168.1.65:3000 — "localhost"
# on a phone means the phone itself. Production builds must use https://whaustralia.com.
EXPO_PUBLIC_API_URL=http://192.168.1.65:3000

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Publishable key only (never the secret key). Must be from the SAME Stripe account
# and mode as the backend's STRIPE_SECRET_KEY.
#   development / preview → pk_test_…   production → pk_live_…
# The app refuses to start if the key is missing or the wrong mode for the build.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Google sign-in ───────────────────────────────────────────────────────────
# OAuth client IDs (Google Cloud Console). Leave empty until set up — the
# "Continue with Google" button shows a "not set up yet" message while empty.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
