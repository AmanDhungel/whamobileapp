# Base URL of the WHA backend (the website itself — see docs/mobile/00-README.md).
# No trailing slash. For a local `npm run dev` backend use your PC's LAN IP,
# e.g. http://192.168.1.20:3000 — "localhost" on a phone means the phone itself.
EXPO_PUBLIC_API_URL=https://whaustralia.com

# Google sign-in OAuth client IDs (Google Cloud Console). Leave empty until set up —
# the "Continue with Google" button shows a "not set up yet" message while empty.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
